[global]
    monitor = 0
    follow = mouse
    width = 350
    height = 100
    origin = top-right
    offset = 10x40
    notification_limit = 5
    progress_bar = true
    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#5a5a5a"
    separator_color = frame
    sort = yes
    idle_threshold = 120
    font = HackNerdFont 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    corner_radius = 0
    mouse_left_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1a1a1a"
    foreground = "#808080"
    timeout = 5

[urgency_normal]
    background = "#1a1a1a"
    foreground = "#d4d4d4"
    timeout = 8

[urgency_critical]
    background = "#1a1a1a"
    foreground = "#f44747"
    frame_color = "#f44747"
    timeout = 0
