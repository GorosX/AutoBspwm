#!/bin/sh

pgrep -x sxhkd > /dev/null || sxhkd &
pgrep -x picom > /dev/null || picom --config "$HOME/.config/picom/picom.conf" &
pgrep -x dunst > /dev/null || dunst &

# Clipboard bidireccional (host ↔ VM)
"$HOME/Scripts/clipboard-sync.sh" start &

"$HOME/.config/polybar/launch.sh" &

feh --bg-fill "$HOME/.config/bspwm/wallpaper.jpg" 2>/dev/null || feh --bg-solid '#1a1a1a' &

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width            2
bspc config window_gap              6
bspc config split_ratio             0.52
bspc config borderless_monocle      true
bspc config gapless_monocle         true
bspc config focus_follows_pointer   true

bspc config pointer_modifier        mod4
bspc config pointer_action1         move
bspc config pointer_action2         resize_side
bspc config pointer_action3         resize_corner

bspc config normal_border_color     "#2d2d2d"
bspc config active_border_color     "#5a5a5a"
bspc config focused_border_color    "#d4d4d4"
bspc config presel_feedback_color   "#3a3a3a"

bspc rule -a Burp desktop='^3' follow=on
bspc rule -a firefox desktop='^2' follow=on
bspc rule -a Wireshark desktop='^4' follow=on

xsetroot -cursor_name left_ptr &
